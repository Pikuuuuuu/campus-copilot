# ---- Free setup (no credit card) --------------------------------------
# Get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Alternative free provider: https://console.groq.com/keys
# LLM_PROVIDER=groq
# GROQ_API_KEY=

# Paid option
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

ADMIN_PASSWORD=change-me

# ---- Optional overrides ----------------------------------------------
# ANSWER_MODEL=gemini-2.5-flash-lite
# JUDGE_MODEL=gemini-2.5-flash
# EMBED_MODEL=gemini-embedding-001
# EMBED_DIM=768
# TOP_K=6
# CHUNK_CHARS=900
# CHUNK_OVERLAP=150

# Only if you outgrow the local vector file
# PINECONE_API_KEY=
# PINECONE_INDEX=campus-copilot
